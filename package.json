{
  "name": "pixel-prix",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:ui": "node scripts/check-ui.js",
    "check:stewards": "node scripts/check-stewarding.js",
    "check:handling": "node scripts/check-handling.js",
    "check:dynamics": "node scripts/check-vehicle-dynamics.js",
    "check:grand-prix": "node scripts/check-grand-prix.js",
    "check:ghost": "node scripts/check-ghost-replay.js",
    "build": "npm run check:ui && npm run check:stewards && npm run check:handling && npm run check:dynamics && npm run check:grand-prix && npm run check:ghost && vite build",
    "preview": "vite preview",
    "deploy": "vite build && gh-pages -d dist",
    "verify:supabase": "node scripts/verify-supabase.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "phaser": "^3.80.0"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "vite": "^8.1.5"
  }
}
